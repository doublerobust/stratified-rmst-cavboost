#!/bin/bash
# Pre-push hook: verify pipeline integrity before pushing to remote.
#
# This hook runs whenever `git push` is executed. It checks:
# 1. If any changed file is part of the moe pipeline (extract, train, evaluate)
# 2. If so, runs the end-to-end test on a 3-config dataset
# 3. Blocks the push if the test fails
#
# This is the automated gate for "trace the full data path" rule.
# If you're reading this because the hook blocked your push, run:
#   git push --no-verify
# ONLY if you are certain the pipeline change is correct and the test
# is stale. Otherwise fix the test or the code.

set -euo pipefail

MOE_DIR="moe"
HOOK_LOG="/tmp/moe-pipeline-verify.log"

# Files that trigger the pipeline check
PIPELINE_PATTERNS=(
  "moe/extract_gate_data.R"
  "moe/evaluate_gate.R"
  "moe/gate_features.R"
  "moe/run_parallel_extraction.py"
  "moe/run_parallel_gate.py"
  "moe/gate_importance_viz.R"
)

# Check if any staged/committed files match pipeline patterns
TRIGGERED=0
while read -r changed_file; do
  for pattern in "${PIPELINE_PATTERNS[@]}"; do
    if [[ "$changed_file" == "$pattern" ]]; then
      TRIGGERED=1
      break
    fi
  done
done < <(git diff --name-only HEAD @{u} 2>/dev/null || echo "")

# Also check files changed in the commit being pushed
while read -r changed_file; do
  for pattern in "${PIPELINE_PATTERNS[@]}"; do
    if [[ "$changed_file" == "$pattern" ]]; then
      TRIGGERED=1
      break
    fi
  done
done < <(git diff --cached --name-only 2>/dev/null || echo "")

# Also check if there are uncommitted changes to pipeline files
if git diff --name-only 2>/dev/null | grep -qE "moe/(extract_gate_data|evaluate_gate|gate_features|run_parallel)"; then
  TRIGGERED=1
fi

if [ "$TRIGGERED" -eq 0 ]; then
  # No pipeline files changed — skip check
  exit 0
fi

echo "🔍 Pipeline files changed — running end-to-end verification..."
echo "   (log: $HOOK_LOG)"

# Run the test from the repo root
cd "$(git rev-parse --show-toplevel)"

# Ensure we have a test script
TEST_SCRIPT="$MOE_DIR/test_e2e_refactored.R"
if [ ! -f "$TEST_SCRIPT" ]; then
  echo "❌ ERROR: $TEST_SCRIPT not found. Create it from git history or restore it."
  echo "   Pipeline changes cannot be pushed without a working test."
  exit 1
fi

# Clear any stale test CSVs
rm -f "$MOE_DIR/results/gate_training_data.csv"
rm -f "$MOE_DIR/results/chunk_*.csv"
unlink "$MOE_DIR/test_raw" 2>/dev/null || true

# Run the test
if Rscript "$TEST_SCRIPT" > "$HOOK_LOG" 2>&1; then
  echo "✅ Pipeline verification PASSED — pushing allowed."
  rm -f "$MOE_DIR/results/gate_training_data.csv"
  exit 0
else
  echo "❌ Pipeline verification FAILED — push blocked."
  echo ""
  echo "   Last 30 lines of log ($HOOK_LOG):"
  tail -30 "$HOOK_LOG" | sed 's/^/   /'
  echo ""
  echo "   To override (NOT recommended): git push --no-verify"
  exit 1
fi
